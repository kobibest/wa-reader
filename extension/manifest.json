{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "WA Reader",
  "version": "2.3.0",
  "description": "__MSG_extDescription__",
  "default_locale": "he",
  "homepage_url": "https://kobibest.github.io/wa-reader/",
  "author": "Kobi Eitan – Eitan | Organizational Digitization",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "ui/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ws://127.0.0.1:17345; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
