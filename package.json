  "type": "module",
  "bin": {
    "wa-reader-mcp": "mcp/server.js"
  },
  "files": [
    "mcp/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Kobi Eitan – Eitan | Organizational Digitization (https://digital.m-eitan.co.il)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobibest/wa-reader.git"
  },
  "keywords": [
    "mcp",
    "whatsapp",
    "claude",
    "model-context-protocol",
    "chrome-extension"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build:mcpb": "./scripts/build-mcpb.sh",
    "build:extension": "./scripts/package.sh"
  }
}
